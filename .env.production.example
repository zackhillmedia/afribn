NODE_ENV=production
PORT=3000

# Persistence
# For Docker/persistent-disk deployment, keep these paths inside the mounted volume.
AFRIBN_DB_PATH=/app/data/afribn.sqlite
AFRIBN_UPLOAD_DIR=/app/uploads
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Auth
AFRIBN_JWT_SECRET=

# AI distillation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# News/API collection adapters
# GDELT does not require a key.
NEWSAPI_API_KEY=
NEWSDATA_API_KEY=
WORLDNEWS_API_KEY=

# Optional Postgres migration target.
# The current runtime uses SQLite persistence. DATABASE_URL is only needed for migrations/next DB phase.
DATABASE_URL=

# Email alerts through SendGrid
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=alerts@afribn.com
ALERT_EMAIL_TO=

# SMS alerts through Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=
